# Safe by default. Use safe_apply only for approved reversible writes.
# Sprint closing, moving, or splitting requires approved_destructive.
MODE=recommend_only
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_BEARER_TOKEN=

JIRA_INSTANCES_FILE=config/jira_instances.json
REQUEST_TIMEOUT_SECONDS=60
MAX_SEARCH_RESULTS=5000
BULK_BATCH_SIZE=500

# The instance config uses credentials="cloud" and credentials="onprem".
# The runtime derives these environment variable names automatically.
JIRA_CLOUD_EMAIL=you@example.com
JIRA_CLOUD_API_TOKEN=replace-me
JIRA_ONPREM_PAT=replace-me

# Optional Data Center fallback if a PAT is unavailable:
# JIRA_ONPREM_USERNAME=replace-me
# JIRA_ONPREM_PASSWORD=replace-me

LOCAL_REPO_ROOT=/absolute/path/to/parent-folder-containing-repos
SECURITY_ISSUE_SUMMARY_MARKER=Operational Security Issue
